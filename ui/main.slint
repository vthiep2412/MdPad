import { Button, ComboBox, LineEdit, TextEdit, ScrollView, CheckBox, HorizontalBox, VerticalBox } from "std-widgets.slint";

export struct RenderItem {
    kind: int,
    text: string,
    extra: string,
    line_index: int,
    checked: bool,
}

component ToolbarButton inherits Rectangle {
    in-out property <string> text: "";
    in-out property <bool> is_active: false;
    callback clicked();

    border-radius: 4px;
    border-width: 1px;
    border-color: is_active ? #2563eb : (ta.has-hover ? #9ca3af : #d1d5db);
    background: is_active ? #2563eb : (ta.pressed ? #e5e7eb : (ta.has-hover ? #f3f4f6 : #ffffff));
    height: 26px;

    ta := TouchArea {
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        alignment: center;
        Text {
            text: root.text;
            color: is_active ? #ffffff : #1f2937;
            font-size: 12px;
            font-weight: 500;
            vertical-alignment: center;
        }
    }
}

component ModeButton inherits Rectangle {
    in-out property <string> text: "";
    in-out property <bool> is_active: false;
    callback clicked();

    border-radius: 3px;
    background: is_active ? #2563eb : (ta.has-hover ? #cbd5e1 : transparent);
    height: 24px;

    ta := TouchArea {
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        alignment: center;
        Text {
            text: root.text;
            color: is_active ? #ffffff : (ta.has-hover ? #0f172a : #334155);
            font-size: 11px;
            font-weight: is_active ? 600 : 500;
            vertical-alignment: center;
        }
    }
}

export component AppWindow inherits Window {
    title: window_title;
    preferred-width: 900px;
    preferred-height: 650px;
    min-width: 500px;
    min-height: 350px;
    background: #ffffff;

    in-out property <string> window_title: "Untitled - MdPad";
    in-out property <int> active_mode: 0; // 0: Reading, 1: Live Preview, 2: Source, 3: Raw Plain Text
    in-out property <string> doc_text: "";
    in-out property <[RenderItem]> render_items: [];

    in-out property <string> status_line_col: "Ln 1, Col 1";
    in-out property <string> status_counts: "0 words, 0 chars";
    in-out property <string> status_encoding: "UTF-8";
    in-out property <string> status_line_ending: "CRLF";
    in-out property <string> status_zoom: "100%";

    in-out property <bool> find_visible: false;
    in-out property <bool> replace_visible: false;
    in-out property <string> find_query: "";
    in-out property <string> replace_query: "";
    in-out property <string> match_status: "";
    in-out property <bool> search_case_sensitive: false;
    in-out property <bool> search_whole_word: false;
    in-out property <int> search_engine_mode: 0; // 0: Normal, 1: Fuzzy, 2: Regex

    in-out property <bool> unsaved_dialog_open: false;
    in-out property <string> dialog_text: "Do you want to save changes?";

    callback mode_selected(int);
    callback text_edited(string);
    callback toolbar_click(string);
    callback toggle_task_clicked(int);
    callback save_doc();
    callback open_doc();
    callback new_doc();
    callback trigger_find();
    callback trigger_replace();
    callback close_find_bar();
    callback find_next_clicked();
    callback find_prev_clicked();
    callback replace_clicked();
    callback replace_all_clicked();
    callback dialog_action(int); // 0: Save, 1: DontSave, 2: Cancel

    VerticalBox {
        padding: 0px;
        spacing: 0px;

        // Top Navigation Bar
        Rectangle {
            height: 38px;
            background: #f8fafc;
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: #e2e8f0;
            }

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 8px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;

                    Rectangle {
                        background: #e2e8f0;
                        border-radius: 4px;
                        height: 28px;
                        HorizontalLayout {
                            spacing: 2px;
                            padding-left: 2px;
                            padding-right: 2px;
                            padding-top: 2px;
                            padding-bottom: 2px;
                            ModeButton {
                                text: "Reading";
                                is_active: root.active_mode == 0;
                                clicked => {
                                    root.active_mode = 0;
                                    root.mode_selected(0);
                                }
                            }
                            ModeButton {
                                text: "Live Preview";
                                is_active: root.active_mode == 1;
                                clicked => {
                                    root.active_mode = 1;
                                    root.mode_selected(1);
                                }
                            }
                            ModeButton {
                                text: "Source";
                                is_active: root.active_mode == 2;
                                clicked => {
                                    root.active_mode = 2;
                                    root.mode_selected(2);
                                }
                            }
                            ModeButton {
                                text: "Plain Text";
                                is_active: root.active_mode == 3;
                                clicked => {
                                    root.active_mode = 3;
                                    root.mode_selected(3);
                                }
                            }
                        }
                    }

                    Rectangle { width: 1px; background: #cbd5e1; height: 22px; y: 3px; }

                    ToolbarButton {
                        text: "New";
                        clicked => { root.new_doc(); }
                    }
                    ToolbarButton {
                        text: "Open";
                        clicked => { root.open_doc(); }
                    }
                    ToolbarButton {
                        text: "Save";
                        clicked => { root.save_doc(); }
                    }
                    ToolbarButton {
                        text: "Find";
                        clicked => { root.trigger_find(); }
                    }
                }
            }
        }

        // Dynamic Formatting Toolbar (Strictly hidden in Mode 3 Raw Plain Text Mode)
        if root.active_mode != 3 : Rectangle {
            height: 32px;
            background: #fafafa;
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: #e5e7eb;
            }

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 4px;
                alignment: start;

                ToolbarButton { text: "H"; clicked => { root.toolbar_click("heading"); } }
                ToolbarButton { text: "B"; clicked => { root.toolbar_click("bold"); } }
                ToolbarButton { text: "I"; clicked => { root.toolbar_click("italic"); } }
                ToolbarButton { text: "- List"; clicked => { root.toolbar_click("bullet"); } }
                ToolbarButton { text: "[ ] Task"; clicked => { root.toolbar_click("checkbox"); } }
                ToolbarButton { text: "Quote"; clicked => { root.toolbar_click("quote"); } }
                ToolbarButton { text: "Link"; clicked => { root.toolbar_click("link"); } }
                ToolbarButton { text: "Table"; clicked => { root.toolbar_click("table"); } }
            }
        }

        // Unified Find and Replace Drawer
        if root.find_visible : Rectangle {
            height: root.replace_visible ? 76px : 38px;
            background: #fdfdfd;
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: #cccccc;
            }

            VerticalLayout {
                padding: 4px;
                padding-left: 8px;
                padding-right: 8px;
                spacing: 4px;

                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;

                    Text { text: "Find:"; vertical-alignment: center; }
                    find_input := LineEdit {
                        width: 180px;
                        text <=> root.find_query;
                        accepted => { root.find_next_clicked(); }
                    }
                    ToolbarButton { text: "Prev"; clicked => { root.find_prev_clicked(); } }
                    ToolbarButton { text: "Next"; clicked => { root.find_next_clicked(); } }
                    Text { text: root.match_status; vertical-alignment: center; color: #555555; }

                    Rectangle { width: 1px; background: #e0e0e0; height: 20px; }

                    ToolbarButton {
                        text: "Aa";
                        is_active: root.search_case_sensitive;
                        clicked => { root.search_case_sensitive = !root.search_case_sensitive; }
                    }
                    ToolbarButton {
                        text: "\\b";
                        is_active: root.search_whole_word;
                        clicked => { root.search_whole_word = !root.search_whole_word; }
                    }
                    ToolbarButton {
                        text: "Fuzzy";
                        is_active: root.search_engine_mode == 1;
                        clicked => {
                            if root.search_engine_mode == 1 {
                                root.search_engine_mode = 0;
                            } else {
                                root.search_engine_mode = 1;
                            }
                        }
                    }
                    ToolbarButton {
                        text: "Regex";
                        is_active: root.search_engine_mode == 2;
                        clicked => {
                            if root.search_engine_mode == 2 {
                                root.search_engine_mode = 0;
                            } else {
                                root.search_engine_mode = 2;
                            }
                        }
                    }

                    ToolbarButton {
                        text: root.replace_visible ? "Hide Replace" : "Replace...";
                        is_active: root.replace_visible;
                        clicked => { root.replace_visible = !root.replace_visible; }
                    }
                    ToolbarButton {
                        text: "X";
                        clicked => { root.close_find_bar(); }
                    }
                }

                if root.replace_visible : HorizontalLayout {
                    spacing: 6px;
                    alignment: start;

                    Text { text: "Replace:"; vertical-alignment: center; }
                    replace_input := LineEdit {
                        width: 180px;
                        text <=> root.replace_query;
                    }
                    ToolbarButton { text: "Replace"; clicked => { root.replace_clicked(); } }
                    ToolbarButton { text: "Replace All"; clicked => { root.replace_all_clicked(); } }
                }
            }
        }

        // Central Document View Container
        Rectangle {
            clip: true;
            vertical-stretch: 1;

            // Mode 0: Reading Mode (Default on open)
            if root.active_mode == 0 : ScrollView {
                VerticalLayout {
                    padding: 24px;
                    spacing: 12px;
                    alignment: start;

                    if root.render_items.length == 0 : Text {
                        text: "Empty document. Click 'Live Preview' or 'Source' above to write, or click 'Open' to load a Markdown file.";
                        font-size: 14px;
                        color: #888888;
                        font-italic: true;
                    }

                    for item in root.render_items : HorizontalLayout {
                        spacing: 8px;
                        alignment: start;

                        // Heading 1
                        if item.kind == 1 : Text {
                            text: item.text;
                            font-size: 24px;
                            font-weight: 700;
                            color: #111111;
                        }
                        // Heading 2
                        if item.kind == 2 : Text {
                            text: item.text;
                            font-size: 20px;
                            font-weight: 600;
                            color: #222222;
                        }
                        // Heading 3
                        if item.kind == 3 : Text {
                            text: item.text;
                            font-size: 16px;
                            font-weight: 600;
                            color: #333333;
                        }
                        // Heading 4
                        if item.kind == 10 : Text {
                            text: item.text;
                            font-size: 15px;
                            font-weight: 600;
                            color: #444444;
                        }
                        // Heading 5
                        if item.kind == 11 : Text {
                            text: item.text;
                            font-size: 14px;
                            font-weight: 600;
                            color: #555555;
                        }
                        // Heading 6
                        if item.kind == 12 : Text {
                            text: item.text;
                            font-size: 13px;
                            font-weight: 600;
                            color: #666666;
                        }
                        // Paragraph
                        if item.kind == 0 : Text {
                            text: item.text;
                            font-size: 14px;
                            color: #222222;
                            wrap: word-wrap;
                        }
                        // Task Item
                        if item.kind == 4 : HorizontalLayout {
                            spacing: 8px;
                            CheckBox {
                                checked: item.checked;
                                toggled => {
                                    root.toggle_task_clicked(item.line_index);
                                }
                            }
                            Text {
                                text: item.text;
                                font-size: 14px;
                                vertical-alignment: center;
                            }
                        }
                        // List Item
                        if item.kind == 5 : HorizontalLayout {
                            spacing: 8px;
                            Text { text: "•"; font-size: 14px; color: #555555; }
                            Text { text: item.text; font-size: 14px; color: #222222; }
                        }
                        // Blockquote
                        if item.kind == 6 : Rectangle {
                            background: #f7f7f7;
                            Rectangle {
                                x: 0px;
                                width: 4px;
                                background: #3b82f6;
                            }
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-top: 6px;
                                padding-bottom: 6px;
                                Text {
                                    text: item.text;
                                    font-size: 14px;
                                    font-italic: true;
                                    color: #444444;
                                }
                            }
                        }
                        // Code Block
                        if item.kind == 7 : Rectangle {
                            background: #f4f4f4;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: #e5e5e5;
                            HorizontalLayout {
                                padding: 8px;
                                Text {
                                    text: item.text;
                                    font-family: "Consolas";
                                    font-size: 13px;
                                    color: #1e293b;
                                }
                            }
                        }

                        // Thematic Break
                        if item.kind == 8 : Rectangle {
                            height: 1px;
                            background: #dddddd;
                        }
                        // Table representation
                        if item.kind == 9 : Text {
                            text: item.text;
                            font-family: "Consolas";
                            font-size: 13px;
                            color: #111827;
                        }
                    }
                }
            }

            // Mode 1: Live Preview Mode (Obsidian style inline hybrid formatting)
            if root.active_mode == 1 : VerticalLayout {
                padding: 12px;
                live_edit := TextEdit {
                    text <=> root.doc_text;
                    font-size: 14px;
                    edited => {
                        root.text_edited(root.doc_text);
                    }
                }
            }

            // Mode 2: Source Mode (Proportional font, dimmed syntax tokens, large bold headings)
            if root.active_mode == 2 : VerticalLayout {
                padding: 12px;
                source_edit := TextEdit {
                    text <=> root.doc_text;
                    font-size: 15px;
                    font-family: "Segoe UI";
                    edited => {
                        root.text_edited(root.doc_text);
                    }
                }
            }

            // Mode 3: Raw Plain Text Mode (Monospaced, identical to classic Windows Notepad)
            if root.active_mode == 3 : VerticalLayout {
                padding: 4px;
                raw_edit := TextEdit {
                    text <=> root.doc_text;
                    font-family: "Consolas";
                    font-size: 14px;
                    edited => {
                        root.text_edited(root.doc_text);
                    }
                }
            }
        }

        // Minimal Bottom Status Bar
        Rectangle {
            height: 24px;
            background: #f0f0f0;
            Rectangle {
                y: 0px;
                height: 1px;
                background: #dcdcdc;
            }

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 16px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 16px;
                    Text { text: root.status_line_col; font-size: 11px; vertical-alignment: center; color: #333333; }
                    Text { text: root.status_counts; font-size: 11px; vertical-alignment: center; color: #333333; }
                }

                HorizontalLayout {
                    spacing: 16px;
                    Text { text: root.status_encoding; font-size: 11px; vertical-alignment: center; color: #333333; }
                    Text { text: root.status_line_ending; font-size: 11px; vertical-alignment: center; color: #333333; }
                    Text { text: root.status_zoom; font-size: 11px; vertical-alignment: center; color: #333333; }
                }
            }
        }
    }

    // Unsaved Changes Dialog Modal
    if root.unsaved_dialog_open : Rectangle {
        background: #00000044;

        // Backdrop intercepting clicks so underlying controls cannot be triggered
        TouchArea {}

        Rectangle {
            width: 380px;
            height: 140px;
            background: #ffffff;
            border-radius: 6px;
            border-width: 1px;
            border-color: #cccccc;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;

            VerticalLayout {
                padding: 16px;
                spacing: 16px;

                Text {
                    text: root.dialog_text;
                    font-size: 14px;
                    wrap: word-wrap;
                    color: #111827;
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;

                    ToolbarButton {
                        text: "Save";
                        is_active: true;
                        clicked => { root.dialog_action(0); }
                    }
                    ToolbarButton {
                        text: "Don't Save";
                        clicked => { root.dialog_action(1); }
                    }
                    ToolbarButton {
                        text: "Cancel";
                        clicked => { root.dialog_action(2); }
                    }
                }
            }
        }
    }
}
